{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "DATABASE_ADMIN_URL",
        "TEST_REDIS_URL",
        "REQUIRE_REDIS",
        "REQUIRE_PYREADSTAT"
      ]
    }
  }
}
