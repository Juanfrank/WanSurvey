{
  "name": "@wansurvey/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "db:seed-demo": "tsx src/db/seed-demo.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "12.34.0",
    "@napi-rs/canvas": "1.0.11",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@wansurvey/exporters": "workspace:*",
    "@wansurvey/fixtures": "workspace:*",
    "@wansurvey/logic": "workspace:*",
    "@wansurvey/schema": "workspace:*",
    "bullmq": "5.81.5",
    "compression": "1.8.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "jose": "^6.2.12",
    "jsqr": "1.4.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "10.0.16",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "pngjs": "7.0.0",
    "postgres": "^3.4.7",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@swc/core": "^1.12.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "2.2.0",
    "@types/nodemailer": "8.0.2",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "^6.0.3",
    "azurite": "3.37.0",
    "drizzle-kit": "0.31.11",
    "supertest": "^7.1.1",
    "tsx": "^4.20.0",
    "unplugin-swc": "^1.5.5"
  }
}
