NODE_ENV=development
PORT=3000
# Restricted application user (row-level security enforced); created/updated by `pnpm db:migrate`.
DATABASE_URL=mssql://wansurvey_app:Wansurvey-App1%21@localhost:1433/wansurvey?trustServerCertificate=true
# Owner connection for migrations and seeding only.
DATABASE_ADMIN_URL=mssql://sa:Wansurvey_Dev1%21@localhost:1433/wansurvey?trustServerCertificate=true
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=
# The app's address (links, and Microsoft's redirect: {PUBLIC_URL}/api/auth/entra/callback,
# which Vite passes on to the API in development).
PUBLIC_URL=http://localhost:5173
# Change only for sovereign clouds or tests.
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
# Password sign-in (false in production with Microsoft only: one "Ingresar con Microsoft"
# button, no passwords, no reset links; invitations are accepted by signing in with Microsoft).
PASSWORD_LOGIN=true
# The organisation (slug) the button signs in to without asking for an e-mail, and its
# Microsoft directory: with these five set, its sign-in comes from here and not from the app.
# SSO_DEFAULT_ORG=pj
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=
# The redirect URI registered in the Entra app, exactly (http only for localhost).
# ENTRA_REDIRECT_URI=http://localhost:5173/api/auth/entra/callback
# ENTRA_ALLOWED_DOMAINS=example.org
# With PASSWORD_LOGIN=true: require Microsoft in that organisation too (owners keep a password).
# ENTRA_ENFORCE=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
LOGIN_RATE_LIMIT=10
# Failed passwords or codes in a row that lock an account, and for how long (0: never lock).
LOGIN_LOCK_AFTER=10
LOGIN_LOCK_MINUTES=15
LOG_LEVEL=info
SEED_PASSWORD=demo-password-123
# Geocoding of case addresses (off by default). With nominatim, addresses are sent to
# OpenStreetMap Nominatim (or your own instance at GEOCODER_URL); its policy needs an e-mail.
GEOCODER=none
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_EMAIL=ops@example.org

# E-mail (web surveys). console: logged; file: one JSON file per message in MAIL_OUTBOX_DIR;
# smtp: sent through SMTP_URL (any provider: SES, Postmark, SendGrid…).
MAILER=console
# MAIL_OUTBOX_DIR=/tmp/wansurvey-mail
# SMTP_URL=smtps://user:password@smtp.example.org:465
MAIL_FROM="WanSurvey <encuestas@example.org>"
# Shared secret the mail provider sends in the x-webhook-secret header (bounces, deliveries).
# MAIL_WEBHOOK_SECRET=change-me-to-a-long-random-value
# Base of respondent links (defaults to PUBLIC_URL).
# PUBLIC_SURVEY_URL=https://encuestas.example.org
# How often the e-mail dispatcher runs, in ms (0 turns it off).
DISPATCH_INTERVAL_MS=15000
# Export files: written as they are built and streamed back on download. local: a directory
# (development); blob: Azure Blob Storage (required in production), by the account and
# container names and the app's managed identity, or by a connection string (Azurite: npx azurite-blob).
EXPORT_STORAGE=local
# DATA_DIR=./.exports
# AZURE_STORAGE_ACCOUNT_NAME=<account>
# AZURE_STORAGE_CONTAINER=exports
# AZURE_CLIENT_ID=<user-assigned identity client id>
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true  (with AZURE_STORAGE_CONTAINER)
# Largest export file, in bytes (counted as it is written).
# EXPORT_MAX_BYTES=2000000000
# When the worker refreshes the analysis model (schema bi), as cron in UTC; off: never.
# BI_REFRESH_CRON=40 */6 * * *  (every 6 hours; skipped when nothing changed)
# Background jobs and live dashboards (M1, M2). Without it, jobs run inside the API process;
# with it, also run the worker: `pnpm --filter @wansurvey/api start:worker`.
REDIS_URL=redis://localhost:6379
# Proxies in front of the API (1 behind one load balancer; 3 on Azure App Service behind nginx).
TRUST_PROXY_HOPS=1
# Who may call /health: IPs and CIDR ranges, comma-separated; everyone else gets a 404.
# Empty: everyone (development, tests).
# HEALTH_ALLOWED_IPS=169.254.0.0/16,127.0.0.1
# The worker answers GET /health on this port (needed on Azure App Service).
# WORKER_HEALTH_PORT=8080

# Limits and sizes (the defaults suit one process; see docs/concurrency.md before changing them).
# Database connections per process (API, worker), and statement/lock waits in ms.
# DB_POOL_MAX=10
# DB_WORKER_POOL_MAX=5
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_WORKER_STATEMENT_TIMEOUT_MS=600000
# DB_LOCK_TIMEOUT_MS=5000
# Requests handled at once per API process (beyond it: 503 with Retry-After); 0 turns it off.
# MAX_CONCURRENT_REQUESTS=200
# HTTP keep-alive in ms: longer than the load balancer's idle timeout.
# HTTP_KEEPALIVE_MS=65000
# Requests per minute from one IP address over all routes.
# RATE_LIMIT_PER_IP=5000
# Sample import limits, and addresses geocoded per request.
# IMPORT_MAX_MB=20
# IMPORT_MAX_ROWS=200000
# GEOCODE_MAX=5000
# Jobs a worker process runs at once (light, heavy) and the wait before a failed job's retry.
# JOB_CONCURRENCY=4
# HEAVY_JOB_CONCURRENCY=1
# JOB_RETRY_MS=2000
# Days an export file is kept (0: always).
# EXPORT_RETENTION_DAYS=7
# The built web app, served by the API itself (App Service from a zip, without nginx).
# WEB_DIST=/home/site/wwwroot/public
# Error reporting and tracing, wired only when set.
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
