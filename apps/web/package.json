    "i18next": "25.10.10",
    "leaflet": "1.9.4",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4"
  },
  "devDependencies": {
