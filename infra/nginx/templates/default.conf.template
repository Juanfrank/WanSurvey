# The web app in production (H4): static files with the security headers of
# apps/web/security-headers.ts, and /api proxied to the API on the same origin, so the
# session cookie stays first-party. TLS terminates in front of this (load balancer or ingress).
# The nginx image fills ${API_UPSTREAM} from the environment when it starts: http://api:3000
# in docker compose, http://localhost:3000 when the API is a sidecar of the same App Service
# (docs/azure.md), or the API app's own address when it is a separate app
# (https://<api-app>.azurewebsites.net). nginx's own $variables are left alone.
server {
  listen 8080;
  root /usr/share/nginx/html;
  server_tokens off;

  # Text, scripts, styles and API answers compressed (the live stream is left alone: it is
  # text/event-stream, not listed). Saves most of the transfer of the app and of each sync.
  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_vary on;
  gzip_types text/plain text/css text/csv application/javascript application/json
             application/manifest+json image/svg+xml application/sql;

  # add_header in a location replaces the server's, so the headers sit where documents are
  # served (the app shell); the API sends its own.

  # The host's health check reaches the API (and through it the database) via this container.
  location = /health {
    proxy_pass ${API_UPSTREAM}/health;
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_read_timeout 10s;
  }

  # Live dashboards (Server-Sent Events): not buffered, kept open.
  location ~ ^/api/v1/projects/[^/]+/live$ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 1h;
  }

  # Export files (up to EXPORT_MAX_BYTES): passed through as they come from Blob Storage, not
  # copied to this container's disk first.
  location ~ ^/api/v1/projects/[^/]+/exports/[^/]+/file$ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 4m;
  }

  # Scanned paper forms: several PDFs in one upload.
  location ~ ^/api/v1/projects/[^/]+/papi/scans$ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;
    proxy_read_timeout 5m;
    client_max_body_size 100m;
  }

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    # The API's host name (App Service routes by it); the browser's host goes in X-Forwarded-Host.
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Answers are buffered here, so a slow connection (a large export to a phone) holds nginx,
    # not the API's memory and connections.
    # Within App Service's own 230-second limit.
    proxy_read_timeout 4m;
    client_max_body_size 25m;
  }

  # Hashed assets never change; the app shell and service worker are always revalidated.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }
  location = /sw.js {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }
  location / {
    add_header Cache-Control "no-cache";
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self'; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    try_files $uri /index.html;
  }
}
