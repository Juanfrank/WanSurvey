{
  "name": "@wansurvey/exporters",
  "version": "0.1.0",
  "private": true,
  "description": "Data exports: the dataset from interviews, and CSV, SPSS (.sav), Stata (.dta) and ZIP writers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wansurvey/logic": "workspace:*",
    "@wansurvey/schema": "workspace:*"
  }
}
