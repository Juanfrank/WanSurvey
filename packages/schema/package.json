{
  "name": "@wansurvey/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sampling": {
      "types": "./dist/sampling.d.ts",
      "default": "./dist/sampling.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "default": "./dist/feedback.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
