{
  "name": "@wansurvey/renderer",
  "version": "0.1.0",
  "private": true,
  "description": "React components that render a questionnaire for each mode (CATI, CAPI, CAWI, PAPI).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wansurvey/logic": "workspace:*",
    "@wansurvey/schema": "workspace:*",
    "i18next": "26.5.2",
    "react-i18next": "17.1.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wansurvey/fixtures": "workspace:*",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "sideEffects": false
}
