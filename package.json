{
  "name": "wansurvey",
  "version": "0.1.0-alpha.19",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Juanfrank/WanSurvey"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "e2e": "pnpm --filter @wansurvey/web e2e",
    "release:check": "node scripts/release.mjs check",
    "release": "node scripts/release.mjs bump"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.6.0",
    "turbo": "2.11.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
